    body {
      margin: 0;
      min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      /* Soft blush pink gradient background */
      background: linear-gradient(145deg, #FFF0F5, #FFE4E1);
