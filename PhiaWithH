    .subtitle { margin: 6px 0 27px; color: #7a6b73; font-size: 15px; letter-spacing: 0.5px;}
    .links { display: grid; gap: 13px; }
    .links a {
      display: block;
      text-decoration: none;
      color: #555;
      background: white;
      padding: 17px 18px;
      border-radius: 15px;
      font-weight: 600;
      /* Soft pinkish shadow for the buttons */
      box-shadow: 0 5px 18px rgba(216, 167, 177, 0.15);
      transition: transform .15s ease, box-shadow .15s ease;
    }
    .links a:active { transform: scale(.98); }
    .links a:hover { 
      box-shadow: 0 8px 20px rgba(216, 167, 177, 0.35); 
      color: #D8A7B1; 
    }
    footer { margin-top: 28px; color: #b59fa8; font-size: 12px; }
